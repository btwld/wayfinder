.dart_tool/
build/
coverage/
# Published library package: the lockfile stays local (okf convention).
pubspec.lock
!tool/release/pubspec.lock
!tool/knowledge_import/pubspec.lock
# Local path override onto a sibling okf checkout during development;
# the committed dependency stays hosted.
pubspec_overrides.yaml
HANDOFF.md
*.okf-apply.lock
# okf's bundle lock, which `validate --fix` and okf writes leave in a bundle.
.okf.lock

# IDE files generated by `melos bootstrap`; the documented flow is `melos get`.
.idea/
*.iml

# Ignored source mirrors and importer staging may live inside example projects.
**/.wayfinder-import/

# Local review notes, installation backups, and verification caches.
.context/

# Python bytecode from tool/ci scripts.
__pycache__/
