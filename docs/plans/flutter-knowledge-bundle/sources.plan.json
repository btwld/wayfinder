  "pilot_skill_names": [
    "dart-add-unit-test",
    "flutter-add-widget-test",
    "flutter-apply-architecture-best-practices",
    "flutter-build-responsive-layout",
    "flutter-fix-layout-issues"
  ],
  "release_window": {
    "flutter_stable_families": 3,
    "selection": "discover-on-first-resolve-then-freeze-exact-releases",
    "dart": "released-versions-paired-with-selected-Flutter-SDKs",
    "include_unreleased": false,
    "historical_migration": "one-explicit-verified-selection-outside-window-permitted"
  },
  "sources": [
