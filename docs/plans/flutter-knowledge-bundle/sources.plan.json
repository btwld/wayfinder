    "api_reference_mode": "selected-symbols-only",
    "rights": "recheck-per-file-and-linked-artifact-at-locked-revision",
    "license_change": "invalidate-affected-publication-approval",
    "provenance_location": "outside-OKF-frontmatter",
    "on_unresolved_required_source": "report-gap-and-block-full-completion"
