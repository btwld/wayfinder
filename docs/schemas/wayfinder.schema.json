{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/btwld/wayfinder/blob/main/docs/schemas/wayfinder.schema.json",
  "title": "Wayfinder project configuration",
  "description": "Project configuration supporting direct Profile sources and legacy installed bindings.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profiles",
        "bundles"
      ],
      "properties": {
        "version": {
          "const": 1,
          "description": "Wayfinder configuration schema version."
        },
        "default_bundle": {
          "type": "string",
          "minLength": 1,
          "description": "Reserved future default bundle ID for legacy configuration."
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/profileBinding"
          },
          "description": "Legacy project-local Profile bindings."
        },
        "bundles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundle"
          },
          "description": "Legacy explicit bundle entries."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profiles"
      ],
      "properties": {
        "version": {
          "const": 1,
          "description": "Wayfinder configuration schema version."
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/directProfile"
          },
          "description": "Direct Profile sources and the bundle paths they apply to."
        }
      }
    }
  ],
  "$defs": {
    "profileReference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*/[0-9]{4}\\.[0-9]+$",
      "description": "Installed Profile identity, conventionally displayed as profile_id/YYYY.serial."
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implements"
      ],
      "properties": {
        "implements": {
          "$ref": "#/$defs/profileReference",
          "description": "The installed base Profile selected by this project binding."
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/customType"
          },
          "description": "Project-specific type extensions. Standard Profile types are not repeated here."
        },
        "actors": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/actor"
          },
          "description": "Lookup metadata for actor IDs used by this binding's bundles. Actor IDs remain opaque OKF values."
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tagDefinition"
          },
          "description": "Project-specific declared tags. Names must be unique within the binding and must not collide with Profile tags."
        }
      }
    },
    "customType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A project type added to the selected Profile's effective type registry."
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "client",
            "internal",
            "vendor",
            "tool",
            "unknown"
          ]
        }
      },
      "description": "Minimal actor lookup metadata. Organization, role, and side are optional contextual fields."
    },
    "tagDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path from wayfinder.json. Wayfinder rejects absolute paths and paths escaping the project."
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Key in the top-level profiles object."
        }
      }
    },
    "profileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git",
        "ref",
        "path"
      ],
      "properties": {
        "git": {
          "type": "string",
          "minLength": 1,
          "description": "Git repository URL or local Git repository path."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Branch, tag, or commit without a prefix."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "description": "Relative Profile directory inside the Git revision."
        }
      }
    },
    "directProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "applies_to"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/profileSource"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "description": "Bundle paths relative to wayfinder.json. An entry used only as an extends parent may have an empty array."
        },
        "extends": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Optional parent Profile key."
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/customType"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tagDefinition"
          }
        },
        "actors": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/actor"
          }
        }
      },
      "description": "A direct Profile source and its project applications."
    }
  }
}
