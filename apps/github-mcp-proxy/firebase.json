{
  "functions": [
    {
      "codebase": "default",
      "source": ".",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".firebase",
        "*.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "test",
        "*.spec.ts",
        "Dockerfile",
        "tsconfig*.json",
        "vitest.config.ts"
      ]
    }
  ]
}
