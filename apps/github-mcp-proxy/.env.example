# HTTP server binding
PORT=8080
HOST=0.0.0.0

# GitHub API configuration
GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_TOKEN=ghp_replace_me
GITHUB_OWNER=btwld
GITHUB_REPO=wayfinder
# Comma-separated owner/repo allowlist. When omitted and GITHUB_OWNER/GITHUB_REPO
# are set, defaults to "<GITHUB_OWNER>/<GITHUB_REPO>".
ALLOWED_REPOS=btwld/wayfinder
# Only set true if trusted callers supply per-request GitHub tokens via x-github-token.
ALLOW_REQUEST_TOKEN_OVERRIDE=false
GITHUB_REQUEST_TIMEOUT_MS=20000

# MCP transport configuration (always stateless)
MCP_ENDPOINT=/mcp
MCP_ENABLE_JSON_RESPONSE=true

# Authentication (auto | api-key | oauth | firebase | none)
# When auto and no credentials are configured, requests fail closed (401)
# unless ALLOW_UNAUTHENTICATED_ACCESS=true is explicitly set for local dev.
PROXY_AUTH_MODE=auto
# PROXY_API_KEYS=replace-with-random-secret
# ALLOW_UNAUTHENTICATED_ACCESS=false

# OAuth / JWKS / Firebase Auth options (used when PROXY_AUTH_MODE=oauth or firebase)
# MCP_AUTH_RESOURCE=https://your-service.example.com/mcp
# MCP_AUTH_AUTHORIZATION_SERVERS=https://accounts.example.com
# MCP_AUTH_JWKS_URI=https://accounts.example.com/.well-known/jwks.json
# MCP_AUTH_ISSUER=https://accounts.example.com
# MCP_AUTH_AUDIENCE=https://your-service.example.com/mcp
# MCP_AUTH_INTROSPECTION_ENDPOINT=https://accounts.example.com/oauth/introspect
# MCP_AUTH_INTROSPECTION_CLIENT_ID=your-client-id
# MCP_AUTH_INTROSPECTION_CLIENT_SECRET=your-client-secret
# MCP_AUTH_REQUIRED_SCOPES=wayfinder:read
# FIREBASE_AUTH_PROJECT_ID=your-firebase-project-id

# Explicit comma-separated CORS allowlist (empty disables CORS)
# CORS_ORIGINS=http://localhost:3000,https://studio.example.com

# Session defaults
SESSION_REQUIRE_CHECKS_DEFAULT=false
# SESSION_REQUIRED_CHECK_NAMES=Required checks

# GitHub GET retry & MCP resilience defaults
GITHUB_RETRY_MAX_ATTEMPTS=2
GITHUB_RETRY_INITIAL_DELAY_MS=200
GITHUB_RETRY_MAX_DELAY_MS=2000
MCP_TIMEOUT_MS=30000
MCP_RATE_LIMIT_MAX=120
MCP_RATE_LIMIT_WINDOW=1m
