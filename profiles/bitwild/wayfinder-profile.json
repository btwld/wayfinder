        "params": {
          "paths": [
            "index.md",
            "log.md"
          ]
        }
      }
    },
    {
      "id": "root-index-lists-log",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "description": "The root `index.md` of a bundle with no concepts MUST link only `log.md`.",
      "message": "The root index of a bundle with no concepts must link only log.md.",
      "check": {
        "subject": "root",
        "schema": {
          "if": {
            "properties": {
              "has_concepts": {
                "const": false
              },
              "index_links": {
                "type": "array"
              }
            }
          },
          "then": {
            "properties": {
              "index_links": {
                "const": [
                  "log.md"
                ]
              }
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "okf_version": "0.2",
            "files": [
              "index.md",
              "log.md"
            ],
            "has_concepts": false,
            "index_links": [
              "log.md"
            ]
          },
          {
            "okf_version": "0.2",
            "files": [
              "index.md",
              "log.md"
            ],
            "has_concepts": true,
            "index_links": [
              "areas/index.md"
            ]
          },
          {
            "okf_version": null,
            "files": [
              "log.md"
            ],
            "has_concepts": false,
            "index_links": null
          }
        ],
        "invalid": [
          {
            "okf_version": "0.2",
            "files": [
              "index.md",
              "log.md"
            ],
            "has_concepts": false,
            "index_links": [
              "log.md",
              "https://example.test"
            ]
          },
          {
            "okf_version": "0.2",
            "files": [
              "index.md",
              "log.md"
            ],
            "has_concepts": false,
            "index_links": []
          }
        ]
      }
    },
