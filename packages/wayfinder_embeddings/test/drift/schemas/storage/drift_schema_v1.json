  "fixed_sql": [
    {
      "name": "stored_chunks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stored_chunks\" (\"id\" TEXT NOT NULL, \"ordinal\" INTEGER NOT NULL CHECK(\"ordinal\" >= 0), \"source_path\" TEXT NOT NULL, \"line_start\" INTEGER NOT NULL CHECK(\"line_start\" >= 1), \"line_end\" INTEGER NOT NULL CHECK(\"line_end\" >= \"line_start\"), \"content\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"metadata_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "stored_embeddings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stored_embeddings\" (\"chunk_id\" TEXT NOT NULL REFERENCES stored_chunks (id) ON DELETE CASCADE, \"source\" TEXT NOT NULL, \"model\" TEXT NOT NULL, \"dimension\" INTEGER NOT NULL CHECK(\"dimension\" > 0), \"vector\" BLOB NOT NULL, PRIMARY KEY (\"chunk_id\", \"source\", \"model\"), CHECK (length(vector) = dimension * 4));"
        }
      ]
    },
    {
      "name": "generation_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"generation_records\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"record_json\" TEXT NOT NULL, \"checksum\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "stored_chunks_ordinal",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX stored_chunks_ordinal ON stored_chunks (ordinal)"
        }
      ]
    }
