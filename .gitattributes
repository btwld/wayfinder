# Retrieval identities hash fixture contents; preserve them across checkouts.
packages/wayfinder_embeddings/fixtures/** text eol=lf

# Compressed benchmark artifacts must not undergo line-ending conversion.
packages/wayfinder_embeddings/fixtures/benchmarks/*.jsonl.gz binary

# The 0.2.0 ObjectBox database is binary, and the store compares its schema
# markers byte for byte.
packages/wayfinder_embeddings/test/fixtures/objectbox-0.2.0/*.mdb binary
packages/wayfinder_embeddings/test/fixtures/objectbox-0.2.0/*.schema text eol=lf

# The golden test compares bytes; a CRLF checkout would fail every golden.
packages/wayfinder/test/goldens/** text eol=lf
packages/wayfinder/test/published_schema_wording/** text eol=lf

# index-current compares exact bytes and Profile packages are read verbatim,
# so a CRLF checkout would flag every fixture index and change the packages.
packages/wayfinder/test/fixtures/** text eol=lf
examples/** text eol=lf
profiles/** text eol=lf
docs/schemas/** text eol=lf
packages/wayfinder/lib/src/generated/** text eol=lf

# The CLI tests copy and edit these files as LF text, as the other fixture
# directories above are pinned.
packages/wayfinder_cli/test/fixtures/** text eol=lf
# The CLI contract goldens are compared byte for byte, like the core goldens.
packages/wayfinder_cli/test/goldens/** text eol=lf

# seeds_test compares SEEDING.md's blocks with KnowledgeSeeds byte for byte,
# and the skills are installed as written.
skills/** text eol=lf
