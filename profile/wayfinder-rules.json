{
  "$schema": "https://github.com/btwld/wayfinder/blob/main/docs/schemas/wayfinder-rules.schema.json",
  "format": 1,
  "namespace": "concepta-profile",
  "profile": {
    "id": "bitwild_profile",
    "release": "2026.3"
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "frontmatter-key": {
      "x-slot": "okf.frontmatterKeys"
    },
    "type-name": {
      "x-slot": "profile.types"
    },
    "tag-name": {
      "x-slot": "profile.tags"
    },
    "actor-id": {
      "x-slot": "profile.actors"
    }
  },
  "rules": [
    {
      "id": "okf-release-binding",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§11",
      "description": "The bundle root index MUST declare `okf_version: \"0.2\"`.",
      "message": "The bundle root index must declare okf_version: \"0.2\".",
      "check": {
        "builtin": "root-okf-version"
      }
    },
    {
      "id": "configuration-legacy-registry",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.5, §5.2, §6.1.1, §11",
      "description": "A bundle using this release MUST NOT carry legacy root `profile.md`, `types.md`, or `actors.md` registries as competing configuration.",
      "message": "{path} is a legacy 2026.2 registry; remove it when using an external Profile binding.",
      "check": {
        "builtin": "configuration-legacy-registry"
      }
    },
    {
      "id": "configured-type-extension",
      "category": "vocabulary",
      "severity": "advisory",
      "status": "stable",
      "ref": "§5.2",
      "description": "The selected Profile binding registers a project-specific type, which is conformant.",
      "message": "Configured project type {name} is available to this bundle.",
      "check": {
        "builtin": "configured-type-extension"
      }
    },
    {
      "id": "configured-tag-undeclared",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.1",
      "description": "Every used tag MUST appear in the selected Profile manifest or project binding's declared tag vocabulary.",
      "message": "Tags must be declared by the selected Profile binding; found {failing}.",
      "check": {
        "subject": "concept",
        "each": "tags",
        "schema": {
          "properties": {
            "value": {
              "$ref": "#/$defs/tag-name"
            }
          }
        }
      },
      "tests": {
        "slots": {
          "profile.tags": [
            "governance"
          ]
        },
        "valid": [
          {
            "value": "governance",
            "count": 1
          }
        ],
        "invalid": [
          {
            "value": "undeclared",
            "count": 1
          }
        ]
      }
    },
    {
      "id": "configured-tag-duplicate",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.1",
      "description": "A concept MUST NOT repeat a tag value.",
      "message": "A concept must not repeat a tag value; found {failing}.",
      "check": {
        "subject": "concept",
        "each": "tags",
        "schema": {
          "properties": {
            "count": {
              "const": 1
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "value": "governance",
            "count": 1
          }
        ],
        "invalid": [
          {
            "value": "governance",
            "count": 2
          }
        ]
      }
    },
    {
      "id": "concept-baseline-fields",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.1",
      "description": "A concept MUST carry nonempty `type`, `title`, `description`, and `status` fields.",
      "message": "Every concept must contain non-empty string values for type, title, description, and status.",
      "check": {
        "subject": "frontmatter",
        "schema": {
          "required": [
            "type",
            "title",
            "description",
            "status"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/text"
            },
            "title": {
              "$ref": "#/$defs/text"
            },
            "description": {
              "$ref": "#/$defs/text"
            },
            "status": {
              "$ref": "#/$defs/text"
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "type": "Guide",
            "title": "Title",
            "description": "Summary.",
            "status": "stable"
          }
        ],
        "invalid": [
          {
            "type": "Guide",
            "title": "Title",
            "description": "Summary."
          },
          {
            "type": " ",
            "title": "Title",
            "description": "Summary.",
            "status": "stable"
          },
          {
            "type": 1,
            "title": "Title",
            "description": "Summary.",
            "status": "stable"
          }
        ]
      }
    },
    {
      "id": "frontmatter-fields-okf",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.1",
      "description": "Bitwild producers MUST NOT introduce namespaced or otherwise producer-defined frontmatter fields.",
      "message": "Bitwild producers may use only OKF 0.2 frontmatter fields; found {failing}.",
      "check": {
        "subject": "concept",
        "each": "keys",
        "schema": {
          "properties": {
            "value": {
              "$ref": "#/$defs/frontmatter-key"
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "value": "type"
          },
          {
            "value": "sources"
          }
        ],
        "invalid": [
          {
            "value": "confidence"
          }
        ]
      }
    },
    {
      "id": "status-value",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.1",
      "description": "A concept's `status` MUST be `draft`, `stable`, or `deprecated`.",
      "message": "Status must be draft, stable, or deprecated.",
      "check": {
        "subject": "frontmatter",
        "schema": {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "pattern": "^\\s*(draft|stable|deprecated)\\s*$"
              }
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "status": "draft"
          },
          {
            "status": " stable "
          },
          {
            "status": ""
          },
          {},
          {
            "status": 1
          }
        ],
        "invalid": [
          {
            "status": "final"
          },
          {
            "status": "Stable"
          }
        ]
      }
    },
    {
      "id": "tag-literal-duplication",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.1",
      "description": "A tag MUST NOT exactly repeat the concept's `type`, `status`, derived trust tier, or a standard relationship label.",
      "message": "Tags must not duplicate type, status, trust, or standard relationship values; found {failing}.",
      "check": {
        "builtin": "tag-literal-duplication"
      }
    },
    {
      "id": "generation-provenance-recommended",
      "category": "provenance",
      "severity": "advisory",
      "status": "stable",
      "ref": "§5.1",
      "description": "A concept carries no `generated` field recording how its current content was produced.",
      "message": "Generation provenance is recommended when it is known.",
      "check": {
        "subject": "frontmatter",
        "schema": {
          "required": [
            "generated"
          ]
        }
      },
      "tests": {
        "valid": [
          {
            "generated": {
              "by": "process:ci"
            }
          },
          {
            "generated": null
          }
        ],
        "invalid": [
          {},
          {
            "type": "Guide"
          }
        ]
      }
    },
    {
      "id": "used-type-registered",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§5.2",
      "description": "Every used concept type MUST resolve in the merged type registry of the selected Profile binding.",
      "message": "Used type {type} must be registered by the selected Profile binding.",
      "check": {
        "subject": "concept",
        "schema": {
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/type-name"
                }
              ]
            }
          }
        }
      },
      "tests": {
        "slots": {
          "profile.types": [
            "Decision"
          ]
        },
        "valid": [
          {
            "path": "a.md",
            "type": "Decision"
          },
          {
            "path": "a.md",
            "type": null
          }
        ],
        "invalid": [
          {
            "path": "a.md",
            "type": "Unregistered"
          }
        ]
      }
    },
    {
      "id": "used-actor-registered",
      "category": "vocabulary",
      "severity": "error",
      "status": "stable",
      "ref": "§3.5, §6.1.1",
      "description": "Every actor ID used in `generated.by`, `verified[].by`, or `sources[].author` MUST appear in the selected Profile binding.",
      "message": "Used actor {id} must be represented in the selected Profile binding.",
      "check": {
        "subject": "actor",
        "schema": {
          "properties": {
            "id": {
              "$ref": "#/$defs/actor-id"
            }
          }
        }
      },
      "tests": {
        "slots": {
          "profile.actors": [
            "process:ci"
          ]
        },
        "valid": [
          {
            "id": "process:ci",
            "first_use": "a.md"
          }
        ],
        "invalid": [
          {
            "id": "agent/unknown",
            "first_use": "a.md"
          }
        ]
      }
    },
    {
      "id": "source-entry-shape",
      "category": "provenance",
      "severity": "error",
      "status": "stable",
      "ref": "§6.1",
      "description": "When `sources` is present, every entry MUST be a mapping carrying the nonempty `resource` OKF requires.",
      "message": "Every present source entry must be a mapping with a non-empty resource.",
      "check": {
        "subject": "frontmatter",
        "schema": {
          "properties": {
            "sources": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "required": [
                  "resource"
                ],
                "properties": {
                  "resource": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        }
      },
      "tests": {
        "valid": [
          {},
          {
            "sources": null
          },
          {
            "sources": []
          },
          {
            "sources": [
              {
                "id": "s1",
                "resource": "/references/a.md"
              }
            ]
          }
        ],
        "invalid": [
          {
            "sources": "/references/a.md"
          },
          {
            "sources": [
              1
            ]
          },
          {
            "sources": [
              {
                "id": "s1"
              }
            ]
          },
          {
            "sources": [
              {
                "resource": " "
              }
            ]
          }
        ]
      }
    },
    {
      "id": "source-id-unique",
      "category": "provenance",
      "severity": "error",
      "status": "stable",
      "ref": "§6.1",
      "description": "Within one concept, each present `sources[].id` MUST be unique.",
      "message": "Source IDs must be unique within a concept.",
      "check": {
        "subject": "concept",
        "schema": {
          "properties": {
            "source_ids": {
              "uniqueItems": true
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "source_ids": [
              "s1",
              "s2"
            ]
          },
          {
            "source_ids": []
          }
        ],
        "invalid": [
          {
            "source_ids": [
              "s1",
              "s1"
            ]
          }
        ]
      }
    },
    {
      "id": "source-attribution-join",
      "category": "provenance",
      "severity": "error",
      "status": "stable",
      "ref": "§6.1",
      "description": "A body footnote reference whose label exactly matches a `sources[].id` is source attribution and MUST join to its footnote definition.",
      "message": "A recognized source-attribution reference must join to its footnote definition.",
      "check": {
        "builtin": "source-attribution-join"
      }
    },
    {
      "id": "source-path-unresolved",
      "category": "provenance",
      "severity": "advisory",
      "status": "stable",
      "ref": "§6.1",
      "description": "A top-level `resource` or `sources[].resource` written as a path resolves to no existing file or directory.",
      "message": "Source path {target} does not resolve to a file or directory.",
      "check": {
        "builtin": "source-path-unresolved"
      }
    },
    {
      "id": "relationships-shape",
      "category": "linking",
      "severity": "error",
      "status": "stable",
      "ref": "§7.2",
      "description": "Each `# Relationships` bullet MUST carry exactly one label and one Markdown link target.",
      "message": "Each Relationships entry must contain exactly one label and one Markdown target.",
      "check": {
        "builtin": "relationships-shape"
      }
    },
    {
      "id": "relationship-label-extension",
      "category": "linking",
      "severity": "advisory",
      "status": "stable",
      "ref": "§7.2",
      "description": "A `# Relationships` bullet uses an additional label outside the preferred standard labels.",
      "message": "The relationship label {label} is a permitted project extension.",
      "check": {
        "builtin": "relationship-label-extension"
      }
    },
    {
      "id": "link-graph-unavailable",
      "category": "linking",
      "severity": "error",
      "status": "stable",
      "ref": "§7.1",
      "description": "The §7.1 link rules MUST be assessed against a buildable OKF link graph of the bundle.",
      "message": "The OKF link graph could not be built ({error}); the §7.1 link rules were not assessed.",
      "check": {
        "builtin": "link-graph-unavailable"
      }
    },
    {
      "id": "internal-link-bundle-relative",
      "category": "linking",
      "severity": "advisory",
      "status": "stable",
      "ref": "§7.1",
      "description": "An internal link uses a target without the leading `/` of a bundle-relative link.",
      "message": "Internal links should use bundle-relative targets.",
      "check": {
        "builtin": "internal-link-bundle-relative"
      }
    },
    {
      "id": "internal-link-unresolved",
      "category": "linking",
      "severity": "advisory",
      "status": "stable",
      "ref": "§7.1, §14.1–§14.2",
      "description": "An internal link's target is absent from the bundle.",
      "message": "An unresolved internal link is permitted and remains an OKF graph edge.",
      "check": {
        "builtin": "internal-link-unresolved"
      }
    },
    {
      "id": "raw-directory-placement",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.4",
      "description": "A `raw/` tier belongs to a source directory and MUST NOT sit directly under `references/`.",
      "message": "A raw/ tier belongs to a source directory; raw/ must not sit directly under references/.",
      "check": {
        "builtin": "raw-directory-placement"
      }
    },
    {
      "id": "raw-directory-markdown",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.4",
      "description": "Within `raw/` and any of its subdirectories under `references/`, the only markdown file permitted is each directory's own `index.md`.",
      "message": "A raw/ tier holds verbatim originals; the only markdown permitted in it is each directory's own index.md.",
      "check": {
        "builtin": "raw-directory-markdown"
      }
    },
    {
      "id": "root-structure-files",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.5",
      "description": "A bundle MUST contain `index.md` and `log.md` at its root.",
      "message": "The configured bundle root must contain index.md and log.md; missing {failing}.",
      "check": {
        "builtin": "root-structure-files",
        "params": {
          "required": [
            "index.md",
            "log.md"
          ]
        }
      }
    },
    {
      "id": "directory-index-present",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.1, §3.4, §9",
      "description": "A nonempty directory MUST contain an `index.md`, including every area, sub-area, `references/`, and nonempty subdirectory of `references/`.",
      "message": "Every nonempty directory must contain index.md.",
      "check": {
        "builtin": "directory-index-present"
      }
    },
    {
      "id": "concept-area-name-collision",
      "category": "structure",
      "severity": "advisory",
      "status": "stable",
      "ref": "§14.1",
      "description": "A concept sits beside an area of the same name rather than inside it.",
      "message": "A concept beside an area of the same name needs contextual placement review.",
      "check": {
        "builtin": "concept-area-name-collision"
      }
    },
    {
      "id": "index-semantic-projection",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§9",
      "description": "Every index MUST be the deterministic semantic projection of its directory.",
      "message": "The index must exactly match its immediate semantic projection.",
      "check": {
        "builtin": "index-semantic-projection"
      }
    },
    {
      "id": "log-entry-lead-word",
      "category": "history",
      "severity": "error",
      "status": "stable",
      "ref": "§10",
      "description": "Every root `log.md` entry MUST start with a nonempty bold lead word followed by a colon.",
      "message": "Every root log entry must begin with a nonempty bold lead word and a colon.",
      "check": {
        "builtin": "log-entry-lead-word"
      }
    }
  ]
}
