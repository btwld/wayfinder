            "resolution": "unresolved",
            "internal": true,
            "bundle_relative": true,
            "resolved": false
          }
        ]
      }
    },
    {
      "id": "raw-directory-placement",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.4",
      "description": "A `raw/` tier belongs to a source directory and MUST NOT sit directly under `references/`.",
      "message": "A raw/ tier belongs to a source directory; raw/ must not sit directly under references/.",
      "check": {
        "subject": "directory",
        "schema": {
          "properties": {
            "path": {
              "not": {
                "const": "references/raw"
              }
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "path": "references/vendor/raw",
            "has_index": true
          },
          {
            "path": "references",
            "has_index": true
          }
        ],
        "invalid": [
          {
            "path": "references/raw",
            "has_index": true
          }
        ]
      }
    },
    {
      "id": "raw-directory-markdown",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.4",
      "description": "Within `raw/` and any of its subdirectories under `references/`, no markdown file is permitted; `index-current` reports a leftover `index.md` there (§9).",
      "message": "A raw/ tier holds verbatim originals; no markdown file is permitted in it.",
      "check": {
        "subject": "file",
        "schema": {
          "not": {
            "allOf": [
              {
                "properties": {
                  "markdown": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "name": {
                    "not": {
                      "const": "index.md"
                    }
                  }
                }
              },
              {
                "properties": {
                  "path": {
                    "pattern": "^references/([^/]+/)*raw/"
                  }
                }
              }
            ]
          }
        }
      },
      "tests": {
        "valid": [
          {
            "path": "references/vendor/raw/index.md",
            "name": "index.md",
            "markdown": true
          },
          {
            "path": "references/vendor/raw/original.pdf",
            "name": "original.pdf",
            "markdown": false
          },
          {
            "path": "references/vendor/note.md",
            "name": "note.md",
            "markdown": true
          },
          {
            "path": "area/raw/note.md",
            "name": "note.md",
            "markdown": true
          }
        ],
        "invalid": [
          {
            "path": "references/vendor/raw/note.md",
            "name": "note.md",
            "markdown": true
          },
          {
            "path": "references/raw/deep/note.md",
            "name": "note.md",
            "markdown": true
          }
        ]
      }
    },
    {
      "id": "root-structure-files",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§3.5",
      "description": "A bundle MUST contain `index.md` and `log.md` at its root.",
      "message": "The configured bundle root must contain index.md and log.md; missing {failing}.",
      "check": {
        "builtin": "root-structure-files",
        "params": {
          "required": [
            "index.md",
            "log.md"
          ]
        }
      }
    },
    {
      "id": "concept-area-name-collision",
      "category": "structure",
      "severity": "advisory",
      "status": "stable",
      "ref": "§14.1",
      "description": "A concept sits beside an area of the same name rather than inside it.",
      "message": "A concept beside an area of the same name needs contextual placement review.",
      "check": {
        "subject": "concept",
        "schema": {
          "properties": {
