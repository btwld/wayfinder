          }
        ],
        "invalid": [
          {
            "path": "area.md",
            "sibling_directory": true
          }
        ]
      }
    },
    {
      "id": "index-current",
      "category": "structure",
      "severity": "error",
      "status": "stable",
      "ref": "§9",
      "description": "Every directory the OKF reference index generator indexes MUST contain an `index.md` identical to the generator's output for the bundle, and a directory holding only non-concept assets, such as a `raw/` tier, MUST NOT carry one.",
      "message": {
        "stale": "{path} is missing or differs from the generated index; run wayfinder validate --fix.",
        "extra": "{path} is not an index the generator writes; delete it, then run wayfinder validate --fix."
      },
      "check": {
        "builtin": "index-current"
      }
    },
    {
      "id": "log-entry-lead-word",
      "category": "history",
      "severity": "error",
      "status": "stable",
      "ref": "§10",
      "description": "Every root `log.md` entry MUST start with a nonempty bold lead word followed by a colon.",
      "message": "Every root log entry must begin with a nonempty bold lead word and a colon.",
      "check": {
        "subject": "log",
        "schema": {
          "properties": {
            "entries": {
              "minItems": 1,
              "items": {
                "properties": {
                  "action": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "tests": {
        "valid": [
          {
            "entries": [
              {
                "date": "2026-08-22",
                "action": "Creation"
              }
            ]
          }
        ],
        "invalid": [
          {
            "entries": []
          },
          {
            "entries": [
              {
                "date": "2026-08-22",
                "action": ""
              }
            ]
          }
        ]
      }
    }
  ]
